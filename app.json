{
  "expo": {
    "name": "Hatchlore",
    "slug": "hatchlore",
    "scheme": "hatchlore",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#171226",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aj.hatchlore",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aj.hatchlore"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#171226",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 220
        }
      ]
    ],
    "owner": "levances-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/822a8ced-8c11-4a75-9401-c1d94d9a314f",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "extra": {
      "eas": {
        "projectId": "822a8ced-8c11-4a75-9401-c1d94d9a314f"
      }
    }
  }
}
